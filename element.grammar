// template
template: $string | element | conditional_element;
conditional_element: if_element | cond_element;
if_element: "(" "if" ($identifier | $bool) template [template] ")";
cond_element: "(" "cond" ($identifier | $bool) {cond_option [","]} ")";
cond_option: $literal ":" template;

// element
element: "(" $identifier_or_member_access {attribute | template} ")"; 

attribute: ["#" $identifier_or_member_access] "{" {key_val [","]} "}";
key_val: $identifier ":" expression;
