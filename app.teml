(package pp "view/app")

(import ui "https://github.com/ui/ui")

(using fancy-button ui)

(using [card not_used] ui)

;; zero or one documents per file
(document home [dog: Dog]
	(dog))

;; zero or more components per file
;; can defined before or after a document
(component Dog
	[ name: String
	, age: Number
	, isAdult: Bool
	, color: (enum "brown" "black")
	]
	(box {id: "dog-card"}
		-- The quick brown fox jumped over the lazy dog!
		-- The fox named \(name) is \(age) \((if isAdult "years" "year")) old.
		(div {data-message:
						(cond color
							"brown": "a good dog"
							"black": "a naughty dog")})
		;; (card (fancy-button "Click Me"))
		-- namespaced reference
		-- not a template \\(foo)
		;; (ui.badge {value: "name"})
		))

;; zero or more layouts per file
;; can be defined before or after a document
(component BaseLayout
	[ header1: Fragment
	, content1: Fragment
	, footer1: Fragment
	]
	(header1)
	-- Leading paragraph
	(content1)
	-- Trailing paragraph
	(footer1))

(component Foo []
	(div
		{ gap: "10px"
		, align-content: "center"
		, justify-items: "center"
		}

		(div "first child")

		{ bind: "value"
		, signal: "foo"
		}

		(div "second child")
		(div {} "third child")))

(component box [])
(component Fragment [])
