(package p "views")

(component A [text: String]
  (text))

;;test:instance B{element: A{text: "Line 1"}, content: "Line 5"}
(component B [element: A, content: String]
  (element           ;; Line 1
    -- Line 2
    "Line 3"
    (div "Line 4")
    (content)        ;; Line 5
    (A [text: "Line 6"])))
