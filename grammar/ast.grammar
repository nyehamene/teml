// root
program: package_decl {import_decl} {using_decl} {templ_decl|enum_decl};

// package
package_decl: "(" $package $identifier $string ")";

// import
import_decl: "(" $import $identifier $string ")";

// using
using_decl: "(" $using (using_single | using_many) $identifier ")";
using_single: $identifier;
using_many: "[" {$identifier [","]} "]";

// templ
templ_decl: {component | document};

// component
properties: "[" {property [","]} "]";
property: $identifier ":" $type;

component: "(" $component $identifier [properties] {$template} ")";

// document
document: "(" $document [$identifier] [properties] {$template} ")";

// enum
enum_decl: "(" $enum $identifier "[" enum_constant {enum_constant} "]" ")";
enum_constant: $identifier [","];
